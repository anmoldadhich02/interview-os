# --- Core ---
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=postgresql+psycopg2://interviewos:interviewos@db:5432/interviewos

# --- Redis (session/cache, used by future Celery workers) ---
REDIS_URL=redis://redis:6379/0

# --- LLM Provider ---
# Provider is swappable. Default wired: openai
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
